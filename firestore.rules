rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ATENÇÃO: esta regra NÃO restringe quem acessa os dados.
    // Qualquer visitante pode receber uma identidade anônima do Firebase.
    function acessoAnonimo() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function dadosValidos(atendimentoId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id','createdAt','client','company','phone','technician',
          'equipment','status','reason','checked','notes'
        ])
        && d.keys().hasAll([
          'id','createdAt','client','company','phone','technician',
          'equipment','status','reason','checked','notes'
        ])
        && d.id is string && d.id.size() > 0 && d.id.size() <= 100
        && d.id == atendimentoId
        && d.createdAt is string && d.createdAt.size() <= 64
        && d.client is string && d.client.size() > 0 && d.client.size() <= 160
        && d.company is string && d.company.size() > 0 && d.company.size() <= 160
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 40
        && d.technician in ['João','Ricardo','']
        && d.equipment is string && d.equipment.size() <= 160
        && d.status in ['pendente','resolvido','nao_resolvido']
        && d.reason in [
          '', 'Manutenção eletrônica', 'Manutenção mecânica',
          'Falta de itens', 'Itens incorretos', 'Cartucho Vencido',
          'Cartucho Avariado', 'Procedimentos incorretos',
          'Sem continuidade do atendimento'
        ]
        && d.checked is bool
        && d.notes is string && d.notes.size() <= 10000;
    }

    match /atendimentos/{atendimentoId} {
      allow read, delete: if acessoAnonimo();
      allow create, update: if acessoAnonimo() && dadosValidos(atendimentoId);
    }
    // Outras coleções permanecem bloqueadas pelas regras padrão.
  }
}
